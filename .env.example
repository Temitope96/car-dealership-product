# Copy this file to .env and fill in your real Supabase connection string.
# .env is gitignored -- never commit real credentials.
SUPABASE_DB_URL=   postgresql://postgres.<CONNECTION_POOLER>:<YOUR_PASSWORD>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Bot token from @BotFather (see the Telegram setup walkthrough). Needed to
# run src/pipelines/telegram_poller.py locally. In production this is set as
# a GitHub Actions secret instead -- never commit the real value.
TELEGRAM_BOT_TOKEN=<PASTE_YOUR_BOT_TOKEN_HERE>